# Copy to .env (chmod 600) and fill in, or let ./install.sh do it. Never commit .env.

# Address you open Saldo at in the browser; the bank return address is derived from it (APP_URL/bank/callback).
APP_URL=https://192.168.1.10:8445
# Optional: further addresses you open Saldo at (comma-separated), e.g. https://saldo.lan
TRUSTED_ORIGINS=

# Random secrets: openssl rand -base64 48  /  openssl rand -base64 32
AUTH_SECRET=
# 32 bytes, base64. Encrypts bank PINs, bank keys and AI keys. Losing it makes them unreadable.
ENCRYPTION_KEY=

POSTGRES_PASSWORD=

# Used only on the very first start to create the admin login; change the password in the app afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Scheduled bank syncs and the daily notifications (08:00) use the server's timezone; set TZ for the app container.
TZ=Europe/Berlin
# "off" disables scheduled syncs, summaries and reminders (development, tests).
SALDO_SCHEDULER=on
# Days the admin audit log (Settings → Protokoll) keeps its entries; older ones are deleted daily.
AUDIT_RETENTION_DAYS=365

# Where the app container listens on the host (put a TLS reverse proxy in front).
BIND_ADDRESS=127.0.0.1
PORT=8000
# Whom Saldo believes X-Forwarded-For from (sign-in throttling, audit log, MCP throttling, bank PSU address).
# off: ignore the header and use the connection's address (default; right when browsers connect directly).
# on: one reverse proxy that sets X-Forwarded-For to the browser's address (nginx: $remote_addr), and the app port is
#     reachable only by it (BIND_ADDRESS=127.0.0.1). Also right for `docker compose --profile local-https`.
# 2-10: that many proxies in a row. Or the proxies' addresses/CIDR ranges, comma-separated, e.g. 172.16.0.0/12.
TRUSTED_PROXY=off

# Days the nightly plain dump of the `backup` service is kept. Encrypted backups: Settings → Sicherung (README).
BACKUP_KEEP_DAYS=30
# Owner of the files in ./backups (your `id -u` / `id -g`); install.sh fills these in. The app container runs as this
# user too, so it can write encrypted backups and the safety copy before a restore there.
BACKUP_UID=
BACKUP_GID=

# Some banks (e.g. comdirect) require the public IP address of the person syncing. Behind a home router Saldo only
# sees a private address, so it looks up the household's public address once an hour (GET https://api.ipify.org).
# Set it here to skip the lookup, or switch the lookup off.
PSU_IP_ADDRESS=
PSU_IP_LOOKUP=on
